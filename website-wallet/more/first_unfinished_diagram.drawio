        <UserObject label="[User]  &#xa;         |  &#xa;         v&#xa; [Submit Tier Selection (POST request)]&#xa;         |  &#xa;         v&#xa;  [tier.php]  &lt;-- Process Data --&gt; [Database Connection (MySQL)]&#xa;         |                                 |&#xa;         v                                 v&#xa;[Check if Tier Selected?]                [Prepare SQL Query]&#xa;         |                                 |&#xa;  (Yes) / \ (No)                        [Bind Parameters]&#xa;         |                                 |&#xa;         v                                 v&#xa;  [Session Check]                  [Execute SQL Query]&#xa;         |                                 |&#xa;         v                                 v&#xa;[Get User ID from Session]       [Update User Tier in Database]&#xa;         |                                 |&#xa;         v                                 v&#xa; [Prepare Update Query]             [Tier Updated?]&#xa;         |                                 |&#xa;         v                                 v&#xa;[Execute Update Query]         (Success) / \ (Failure)&#xa;         |                                 |&#xa;  [Redirect to Profile Page]       [Display Error Message]&#xa;         |                                 |&#xa;         v                                 v&#xa;[Profile Page (profile.html)]          [Error Message]&#xa;         |&#xa;         v&#xa;   [Display Updated Tier]" link="[User]  &#xa;         |  &#xa;         v&#xa; [Submit Tier Selection (POST request)]&#xa;         |  &#xa;         v&#xa;  [tier.php]  &lt;-- Process Data --&gt; [Database Connection (MySQL)]&#xa;         |                                 |&#xa;         v                                 v&#xa;[Check if Tier Selected?]                [Prepare SQL Query]&#xa;         |                                 |&#xa;  (Yes) / \ (No)                        [Bind Parameters]&#xa;         |                                 |&#xa;         v                                 v&#xa;  [Session Check]                  [Execute SQL Query]&#xa;         |                                 |&#xa;         v                                 v&#xa;[Get User ID from Session]       [Update User Tier in Database]&#xa;         |                                 |&#xa;         v                                 v&#xa; [Prepare Update Query]             [Tier Updated?]&#xa;         |                                 |&#xa;         v                                 v&#xa;[Execute Update Query]         (Success) / \ (Failure)&#xa;         |                                 |&#xa;  [Redirect to Profile Page]       [Display Error Message]&#xa;         |                                 |&#xa;         v                                 v&#xa;[Profile Page (profile.html)]          [Error Message]&#xa;         |&#xa;         v&#xa;   [Display Updated Tier]" id="sxZ-Bx4f5nurjPwKOAeU-40">
